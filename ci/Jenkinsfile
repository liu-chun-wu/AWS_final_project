pipeline {
    agent any

    parameters {
        choice(
            name: 'BACKEND_DIR',
            choices: ['demo-backend', 'backend'],
            description: 'Which backend to build and deploy?\n• demo-backend: Flask demo for CI/CD validation\n• backend: Production service'
        )
    }

    environment {
        IMAGE_NAME = 'aws-lab-flask-demo'
        IMAGE_TAG = "${BUILD_NUMBER}"
        AWS_REGION = 'us-east-1'
        // ECR_REGISTRY will be set dynamically based on AWS account
        // For manual configuration, set in Jenkins: Manage Jenkins > Configure System > Global Properties
        ECR_REGISTRY = "${env.AWS_ACCOUNT_ID ? env.AWS_ACCOUNT_ID : 'NOT_SET'}.dkr.ecr.us-east-1.amazonaws.com"
        // Backend directory - defaults to demo-backend if not set
        BACKEND = "${params.BACKEND_DIR ?: 'demo-backend'}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code from repository...'
                checkout scm
                echo 'Source code checked out successfully'
            }
        }

        stage('Branch Check') {
            steps {
                script {
                    def branchName = env.GIT_BRANCH ?: 'unknown'
                    echo "============================================"
                    echo "CI/CD Pipeline - Branch Check"
                    echo "============================================"
                    echo "Current branch: ${branchName}"
                    echo "Backend directory: ${env.BACKEND}"
                    echo ""

                    // Set environment variables based on branch
                    env.IS_JEFFERY_BRANCH = branchName.contains('Jeffery') ? 'true' : 'false'
                    env.IS_MAIN_BRANCH = branchName.contains('main') ? 'true' : 'false'

                    // Determine SAM config based on backend
                    env.SAM_CONFIG = env.BACKEND == 'backend' ? 'samconfig-prod.toml' : 'samconfig-demo.toml'

                    if (env.IS_JEFFERY_BRANCH == 'true') {
                        echo "✅ Jeffery branch detected"
                        echo "   Pipeline mode: CI ONLY (Continuous Integration)"
                        echo "   - Will run: Checkout, Setup, Install, Test, Build"
                        echo "   - Will skip: AWS deployment stages"
                        echo "   Purpose: Fast feedback for development"
                    } else if (env.IS_MAIN_BRANCH == 'true') {
                        echo "✅ Main branch detected"
                        echo "   Pipeline mode: FULL CI/CD (Continuous Integration + Deployment)"
                        echo "   - Will run: All stages including AWS deployment"
                        echo "   - Deploys to: AWS Lambda + API Gateway"
                        echo "   - SAM config: ${env.SAM_CONFIG}"
                        echo "   Purpose: Production deployment"
                    } else {
                        currentBuild.result = 'NOT_BUILT'
                        error("⚠️  Branch '${branchName}' is not configured for CI/CD\n" +
                              "   Supported branches:\n" +
                              "     - Jeffery (CI only)\n" +
                              "     - main (CI + CD)")
                    }

                    echo "============================================"
                }
            }
        }

        stage('Setup Python Environment') {
            steps {
                echo 'Setting up Python virtual environment...'
                sh '''
                    cd ${BACKEND}
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --upgrade pip
                    echo "Python environment setup complete"
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing Python dependencies from requirements.txt...'
                sh '''
                    cd ${BACKEND}
                    . .venv/bin/activate
                    pip install -r requirements.txt
                    echo "Dependencies installed successfully"
                '''
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running test suite...'
                sh '''
                    cd ${BACKEND}
                    . .venv/bin/activate
                    echo "Running unit tests..."
                    pytest tests/unit/ -v
                    echo "Running integration tests..."
                    pytest tests/integration/ -v
                    echo "All tests passed successfully"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ${BACKEND}/
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                    echo "Docker image built successfully: ${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        // ============================================
        // AWS DEPLOYMENT STAGES (Phase 6 - Active)
        // Only run on main branch for production deployment
        // ============================================

        stage('Login to ECR') {
            when {
                expression { env.IS_MAIN_BRANCH == 'true' }
            }
            steps {
                echo '============================================'
                echo 'AWS Stage 1/3: Logging into Amazon ECR'
                echo '============================================'
                echo 'Authenticating Docker to AWS Elastic Container Registry...'
                echo "ECR Registry: ${ECR_REGISTRY}"
                echo "AWS Region: ${AWS_REGION}"
                echo ''
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    echo "✅ ECR authentication successful (valid for 12 hours)"
                '''
            }
        }

        stage('Tag & Push to ECR') {
            when {
                expression { env.IS_MAIN_BRANCH == 'true' }
            }
            steps {
                echo '============================================'
                echo 'AWS Stage 2/3: Pushing Docker Image to ECR'
                echo '============================================'
                echo "Tagging image: ${IMAGE_NAME}:${IMAGE_TAG}"
                echo "ECR destination: ${ECR_REGISTRY}/${IMAGE_NAME}"
                echo ''
                sh '''
                    # Tag with build number
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                    echo "✅ Tagged: ${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

                    # Tag as latest
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REGISTRY}/${IMAGE_NAME}:latest
                    echo "✅ Tagged: ${ECR_REGISTRY}/${IMAGE_NAME}:latest"

                    echo ""
                    echo "Pushing to ECR (this may take 1-2 minutes)..."

                    # Push with build number tag
                    docker push ${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                    echo "✅ Pushed: ${IMAGE_NAME}:${IMAGE_TAG}"

                    # Push latest tag
                    docker push ${ECR_REGISTRY}/${IMAGE_NAME}:latest
                    echo "✅ Pushed: ${IMAGE_NAME}:latest"

                    echo ""
                    echo "✅ Image successfully pushed to ECR"
                '''
            }
        }

        stage('Deploy to Lambda') {
            when {
                expression { env.IS_MAIN_BRANCH == 'true' }
            }
            steps {
                echo '============================================'
                echo 'AWS Stage 3/3: Deploying to AWS Lambda'
                echo '============================================'
                echo 'Deploying via AWS SAM (Serverless Application Model)...'
                echo "SAM Config: ${env.SAM_CONFIG}"
                echo "Backend: ${env.BACKEND}"
                echo 'This will create/update:'
                echo '  - Lambda function (container-based)'
                echo '  - API Gateway (HTTP API)'
                echo '  - IAM roles'
                echo '  - CloudWatch log groups'
                echo ''
                sh '''
                    cd aws

                    echo "Step 1: Building SAM application..."
                    sam build --config-file ${SAM_CONFIG}
                    echo "✅ SAM build complete"

                    echo ""
                    echo "Step 2: Deploying to AWS..."
                    sam deploy --config-file ${SAM_CONFIG} --no-confirm-changeset --no-fail-on-empty-changeset
                    echo "✅ SAM deployment complete"

                    echo ""
                    echo "Step 3: Getting deployment outputs..."
                    STACK_NAME=$(grep "stack_name" ${SAM_CONFIG} | cut -d'"' -f2)
                    aws cloudformation describe-stacks \
                        --stack-name ${STACK_NAME} \
                        --region ${AWS_REGION} \
                        --query 'Stacks[0].Outputs' \
                        --output table

                    echo ""
                    echo "✅ Deployment to Lambda completed successfully"
                '''
            }
        }
    }

    post {
        success {
            script {
                echo '============================================'
                echo '✅ PIPELINE COMPLETED SUCCESSFULLY!'
                echo '============================================'
                echo "Build #${BUILD_NUMBER} finished"
                echo "Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                echo ''

                if (env.IS_JEFFERY_BRANCH == 'true') {
                    echo 'Jeffery Branch (CI Only):'
                    echo '  ✓ Tests passed'
                    echo '  ✓ Docker image built locally'
                    echo '  ℹ AWS deployment skipped (Jeffery branch)'
                    echo ''
                    echo 'Next steps:'
                    echo '  - Review test results in Jenkins'
                    echo '  - When ready, merge to main for production deployment'
                } else if (env.IS_MAIN_BRANCH == 'true') {
                    echo 'Main Branch (Full CI/CD):'
                    echo '  ✓ Tests passed'
                    echo '  ✓ Docker image built and pushed to ECR'
                    echo '  ✓ Deployed to AWS Lambda'
                    echo ''
                    echo 'Deployment complete! Your API is live.'
                    echo ''
                    echo 'Verify deployment:'
                    echo '  ./scripts/aws/05-verify-deployment.sh'
                }
                echo '============================================'
            }
        }
        failure {
            script {
                echo '============================================'
                echo '❌ PIPELINE FAILED'
                echo '============================================'
                echo "Build #${BUILD_NUMBER} failed"
                echo ''
                echo 'Common issues and solutions:'
                echo ''
                echo '  1. Tests failing:'
                echo '     - Check test output in "Run Tests" stage'
                echo '     - Fix failing tests locally: ./scripts/local/test-local.sh'
                echo ''
                echo '  2. Docker build failing:'
                echo '     - Check Dockerfile syntax'
                echo '     - Verify requirements.txt is valid'
                echo '     - Test locally: ./scripts/local/build-local.sh'
                echo ''
                echo '  3. ECR authentication failing:'
                echo '     - Check AWS credentials in Jenkins'
                echo '     - Verify AWS_ACCOUNT_ID environment variable is set'
                echo ''
                echo '  4. SAM deployment failing:'
                echo '     - Check AWS CloudFormation console for stack events'
                echo '     - Verify ECR image exists'
                echo '     - Check aws/template.yaml syntax'
                echo ''
                echo '============================================'
            }
        }
        always {
            echo 'Cleaning up workspace...'
            sh '''
                cd ${BACKEND}
                rm -rf .venv || true
                echo "✓ Cleanup completed"
            '''
        }
    }
}
